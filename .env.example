# ==========================================
# DevCost Lens — Environment Configuration
# ==========================================

# 1. Clerk Authentication (Next.js / Vercel / Vite)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# 2. Database Connection (Supabase or Neon Postgres)
# Direct connection string for Prisma or Drizzle ORM
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"
# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Web Crypto API Encryption Master Secret (AES-GCM for User Keys)
APP_ENCRYPTION_MASTER_KEY="generate_32_byte_hex_or_base64_secret"

# 4. Backend Sensitive Payment Gateways Secret (AES-256-GCM for EasyPaisa / MasterCard storage)
# Prevents EasyPaisa phone number and card details from ever appearing in frontend bundles or DB plain text
PAYMENT_ENCRYPTION_SECRET="devcost_lens_ultra_secure_payment_aes_256_key_2026_xyz"

# 5. AI Provider APIs (for Real-time Price Index & Verification)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="AIzaSy..."
DEEPSEEK_API_KEY="sk-..."

# 5. App & Hosting
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="MY_APP_URL"

